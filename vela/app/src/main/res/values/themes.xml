<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the real theming (see ui/theme). This platform theme only supplies
      the window background / system bar colors used before the first Compose frame.
    -->
    <style name="Theme.Vela" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vela_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
